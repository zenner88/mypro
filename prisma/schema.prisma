// Personal Project Management & Billing System (PPMS)
// Database schema — provider: sqlite (dev) / mysql (prod, see docs/DEPLOYMENT.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS ============

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  role         String    @default("USER") // ADMIN | USER
  plan         String    @default("FREE") // FREE | PRO | UNLIMITED
  maxProjects  Int       @default(1)
  maxInvoices  Int       @default(3)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  clients    Client[]
  projects   Project[]
  invoices   Invoice[]
  quotations Quotation[]
  activities ActivityLog[]

  @@map("users")
}

// ============ CLIENTS ============

model Client {
  id            String    @id @default(cuid())
  userId        String?   @map("user_id")
  code          String    @unique // CLI-2026-0001
  companyName   String    @map("company_name")
  contactPerson String    @map("contact_person")
  email         String?
  phone         String?
  whatsapp      String?
  address       String?
  npwp          String?
  website       String?
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user       User?       @relation(fields: [userId], references: [id])
  projects   Project[]
  invoices   Invoice[]
  quotations Quotation[]
  payments   Payment[]
  documents  Document[]

  @@index([userId])
  @@index([companyName])
  @@index([isActive])
  @@map("clients")
}

// ============ PROJECTS ============

model Project {
  id                   String    @id @default(cuid())
  userId               String?   @map("user_id")
  code                 String    @unique // PRJ-2026-0001
  name                 String
  clientId             String    @map("client_id")
  description          String?
  projectType          String?   @map("project_type") // website | mobile | desktop | api | maintenance | other
  status               String    @default("DRAFT") // DRAFT|PROPOSAL|NEGOTIATION|APPROVED|IN_PROGRESS|ON_HOLD|COMPLETED|CANCELLED
  priority             String    @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  startDate            DateTime? @map("start_date")
  targetCompletionDate DateTime? @map("target_completion_date")
  actualCompletionDate DateTime? @map("actual_completion_date")
  totalValue           Decimal   @default(0) @map("total_value")
  progress             Int       @default(0) // 0-100
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  user       User?             @relation(fields: [userId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id])
  items      ProjectItem[]
  timelines  ProjectTimeline[]
  tasks      Task[]
  payments   Payment[]
  invoices   Invoice[]
  quotations Quotation[]
  documents  Document[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([targetCompletionDate])
  @@map("projects")
}

// ============ PROJECT PRICING ITEMS ============

model ProjectItem {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  qty         Decimal  @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price")
  discount    Decimal  @default(0) // amount, not %
  sortOrder   Int  @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_items")
}

// ============ PROJECT TIMELINE / MILESTONES ============

model ProjectTimeline {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("PENDING") // PENDING|IN_PROGRESS|COMPLETED
  progress    Int   @default(0)
  notes       String?
  sortOrder   Int   @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_timelines")
}

// ============ TASKS ============

model Task {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  name        String
  description String?
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  status      String    @default("TODO") // TODO|IN_PROGRESS|REVIEW|DONE
  priority    String    @default("MEDIUM")
  progress    Int   @default(0)
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

// ============ QUOTATIONS ============

model Quotation {
  id               String    @id @default(cuid())
  userId           String?   @map("user_id")
  number           String    @unique // QUO-2026-0001
  clientId         String    @map("client_id")
  projectId        String?   @map("project_id")
  subject          String
  quotationDate    DateTime  @default(now()) @map("quotation_date")
  validUntil       DateTime? @map("valid_until")
  subtotal         Decimal   @default(0)
  discount         Decimal   @default(0)
  taxPercent       Decimal   @default(0) @map("tax_percent")
  taxAmount        Decimal   @default(0) @map("tax_amount")
  total            Decimal   @default(0)
  status           String    @default("DRAFT") // DRAFT|SENT|APPROVED|REJECTED|EXPIRED
  terms            String?
  notes            String?
  convertedToProjectId String? @map("converted_to_project_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  user   User?    @relation(fields: [userId], references: [id])
  client Client   @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  items  QuotationItem[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String  @map("quotation_id")
  name        String
  description String?
  qty         Decimal @default(1)
  unitPrice   Decimal @default(0) @map("unit_price")
  discount    Decimal @default(0)
  sortOrder   Int @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ============ INVOICES ============

model Invoice {
  id                  String    @id @default(cuid())
  userId              String?   @map("user_id")
  number              String    @unique // INV-2026-0001
  clientId            String    @map("client_id")
  projectId           String?   @map("project_id")
  paymentId           String?   @map("payment_id")
  invoiceDate         DateTime  @default(now()) @map("invoice_date")
  dueDate             DateTime? @map("due_date")
  currency            String    @default("IDR")
  description         String?
  subtotal            Decimal   @default(0)
  discount            Decimal   @default(0)
  taxPercent          Decimal   @default(0) @map("tax_percent")
  taxAmount           Decimal   @default(0) @map("tax_amount")
  total               Decimal   @default(0)
  amountPaid          Decimal   @default(0) @map("amount_paid")
  status              String    @default("DRAFT") // DRAFT|SENT|PARTIALLY_PAID|PAID|OVERDUE|CANCELLED
  notes               String?
  paymentInstructions String?   @map("payment_instructions")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  user    User?    @relation(fields: [userId], references: [id])
  client  Client   @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  items   InvoiceItem[]

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([paymentId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  name        String
  description String?
  qty         Decimal @default(1)
  unitPrice   Decimal @default(0) @map("unit_price")
  discount    Decimal @default(0)
  sortOrder   Int @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============ PAYMENTS (TERMIN) ============

model Payment {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  clientId    String    @map("client_id")
  terminNumber Int  @default(1) @map("termin_number")
  description String?
  percentage  Decimal   @default(0)
  amount      Decimal   @default(0)
  amountPaid  Decimal   @default(0) @map("amount_paid")
  dueDate     DateTime? @map("due_date")
  paidDate    DateTime? @map("paid_date")
  status      String    @default("PENDING") // PENDING|DUE|PARTIALLY_PAID|PAID|OVERDUE|CANCELLED
  paymentMethod String? @map("payment_method") // CASH|BANK_TRANSFER|EWALLET|OTHER
  referenceNumber String? @map("reference_number")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  invoices Invoice[]
  receipts Receipt[]

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@map("payments")
}

// ============ RECEIPTS ============

model Receipt {
  id          String   @id @default(cuid())
  number      String   @unique // REC-2026-0001
  paymentId   String   @map("payment_id")
  amount      Decimal 
  paymentMethod String @map("payment_method")
  paidDate    DateTime @map("paid_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("receipts")
}

// ============ DOCUMENTS ============

model Document {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  clientId    String?  @map("client_id")
  name        String
  category    String   @default("OTHER") // PROPOSAL|QUOTATION|CONTRACT|AGREEMENT|REQUIREMENT|DESIGN|TECHNICAL|REPORT|INVOICE|RECEIPT|FINAL|OTHER
  description String?
  filePath    String   @map("file_path")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  fileSize    Int  @map("file_size") // bytes
  version     Int  @default(1)
  uploadedBy  String   @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])

  @@index([projectId])
  @@index([category])
  @@map("documents")
}

// ============ ACTIVITY LOGS ============

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String // CREATED|UPDATED|DELETED|STATUS_CHANGED|UPLOADED|DOWNLOADED|PAID|CONVERTED|LOGIN
  module      String // PROJECT|CLIENT|INVOICE|PAYMENT|QUOTATION|DOCUMENT|SETTINGS|AUTH
  recordId    String?  @map("record_id")
  description String
  metadata    String? // JSON string
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([recordId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============ SETTINGS (key-value) ============

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============ NUMBER SEQUENCES (atomic numbering) ============

model NumberSequence {
  id        String   @id // e.g. "INV-2026", "PRJ-2026", "QUO-2026", "REC-2026"
  current   Int  @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("number_sequences")
}

// ============ OTP VERIFICATIONS ============

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  name      String?
  password  String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

